# Board-local runtime configuration for RK3588 + one RK1828.
export RK_GATEWAY_HOST=127.0.0.1
export RK_GATEWAY_PORT=8100
# LLM, embedding and reranker share one RK1828. Keep vector models lazy and
# serialize all NPU work through one device-wide lock.
export RK_GATEWAY_SINGLE_DEVICE=1
export RK_GATEWAY_INGEST_MODE_ENABLED=1
# Qwen3.5-2B, embedding and reranker fit together on the 5 GB card. Keep all
# three processes resident and serialize their NPU execution with the shared
# single-device lock; no model is stopped between query stages.
export RK_GATEWAY_LLM_EXCLUSIVE=0
# Retained as a safe rollback setting if exclusive mode is re-enabled.
export RK_GATEWAY_LLM_STOP_WORKERS=embedding
export RK_GATEWAY_MODEL_STOP_SETTLE_SECONDS=1
export RK_GATEWAY_EAGER_WORKERS=llm,reranker,embedding
export RK_LLM_DEFAULT_MAX_TOKENS=512
export RK_LLM_CONTEXT_TOKENS=4096
export RK_QUERY_CONTEXT_RESERVE=128
export LD_LIBRARY_PATH=/userdata/RK1828-qwen3-embedding-reranker-service/lib:/userdata/RK1828-qwen3.5-4b-service/lib

export RK_LLM_MODEL=qwen3.5-2b
export RK_QUERY_MODEL=qwen3.5-2b-query
# This is a ceiling, not a fixed output size. The gateway subtracts the
# estimated prompt and a safety reserve from the 4096-token model context for
# every request, then chooses the smallest of that remainder and this ceiling.
export RK_QUERY_MAX_TOKENS=512
export RK_LLM_SERVER_URL=http://127.0.0.1:8080
export RK_LLM_SERVER_COMMAND='/usr/bin/rkllm3-server --alias qwen3.5-2b --model /userdata/Qwen3.5-2B/Qwen3.5-2B.rknn --weight /userdata/Qwen3.5-2B/Qwen3.5-2B.weight --vocab /userdata/Qwen3.5-2B/Qwen3.5-2B.tokenizer.gguf --embed /userdata/Qwen3.5-2B/Qwen3.5-2B.embed.bin --device-id 0001:11:00.0 --host 127.0.0.1 --port 8080 --ctx-size 4096 --n-predict 512 --core-mask 0xff --top-k 1 --top-p 0.0 --temp 0.0 --reasoning off --reasoning-format deepseek --log-level 1'

# The ingestion state machine stops the resident 2B query model and vector
# workers before starting this 4B model on the same card. It is loaded once
# for the complete document-processing run, not once per chunk.
export RK_INGEST_LLM_MODEL=qwen3.5-4b
export RK_INGEST_LLM_SERVER_URL=http://127.0.0.1:8080
export RK_INGEST_LLM_SERVER_COMMAND='/usr/bin/rkllm3-server --alias qwen3.5-4b --model /userdata/RK1828-qwen3.5-4b-service/models/Qwen3.5-4B/Qwen3.5-4B.rknn --weight /userdata/RK1828-qwen3.5-4b-service/models/Qwen3.5-4B/Qwen3.5-4B.weight --vocab /userdata/RK1828-qwen3.5-4b-service/models/Qwen3.5-4B/Qwen3.5-4B.tokenizer.gguf --embed /userdata/RK1828-qwen3.5-4b-service/models/Qwen3.5-4B/Qwen3.5-4B.embed.bin --device-id 0001:11:00.0 --host 127.0.0.1 --port 8080 --ctx-size 4096 --n-predict 512 --core-mask 0xff --top-k 1 --top-p 0.0 --temp 0.0 --reasoning off --reasoning-format deepseek --log-level 1'

export RK_EMBEDDING_COMMAND='/userdata/RK1828-qwen3-embedding-reranker-service/bin/rk1828_embedding_daemon --config /userdata/RK1828-qwen3-embedding-reranker-service/config/config.json'

export RK_RERANKER_COMMAND='/userdata/RK1828-qwen3-embedding-reranker-service/bin/rk1828_reranker_daemon --config /userdata/RK1828-qwen3-embedding-reranker-service/config/config.json'
