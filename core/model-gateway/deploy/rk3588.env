# Board-local runtime configuration for the current RK3588 + 3x RK1828 setup.
export RK_GATEWAY_HOST=127.0.0.1
export RK_GATEWAY_PORT=8100
# The two vector models share one RK1828. Keep them lazy; the gateway
# serializes their requests through one card-wide lock.
export RK_GATEWAY_EAGER_WORKERS=llm
export RK_LLM_DEFAULT_MAX_TOKENS=512
export LD_LIBRARY_PATH=/userdata/RK1828-qwen3-embedding-reranker-service/lib:/userdata/RK1828-qwen3.5-4b-service/lib

export RK_LLM_MODEL=qwen3.5-4b
export RK_QUERY_MODEL=qwen3.5-4b-query
# Short, complete RAG answers: 128 can cut a numbered answer mid-sentence;
# 256 leaves enough room to finish while avoiding long-form responses.
export RK_QUERY_MAX_TOKENS=256
export RK_LLM_COMMAND='/userdata/RK1828-qwen3.5-4b-service/bin/rk1828_qwen35_9b_2cards_daemon --config /userdata/RK1828-qwen3.5-4b-service/config/qwen35-4b.json --daemon'

export RK_EMBEDDING_COMMAND='/userdata/RK1828-qwen3-embedding-reranker-service/bin/rk1828_embedding_daemon --config /userdata/RK1828-qwen3-embedding-reranker-service/config/config.json'

export RK_RERANKER_COMMAND='/userdata/RK1828-qwen3-embedding-reranker-service/bin/rk1828_reranker_daemon --config /userdata/RK1828-qwen3-embedding-reranker-service/config/config.json'
