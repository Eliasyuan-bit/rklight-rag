# LightRAG API server on RK3588. It calls the board-local RK1828 gateway.
HOST=0.0.0.0
PORT=9621
WORKING_DIR=/userdata/lightrag
INPUT_DIR=/userdata/lightrag/inputs
LOG_DIR=/userdata/lightrag/logs
TIKTOKEN_CACHE_DIR=/userdata/lightrag/tiktoken_cache
LOG_LEVEL=INFO
WORKERS=1
RK_DEFAULT_QUERY_MODE=mix

LLM_BINDING=openai
LLM_BINDING_HOST=http://127.0.0.1:8100/v1
LLM_BINDING_API_KEY=local-no-key
LLM_MODEL=qwen3.5-4b
LLM_TIMEOUT=240
OPENAI_LLM_MAX_COMPLETION_TOKENS=512
MAX_ASYNC_LLM=1
OPENAI_LLM_EXTRA_BODY='{"enable_thinking":false}'
# Qwen3.5-4B has a 4096-token context window. Keep retrieved context below
# 3000 tokens, leaving room for a complete 512-token answer in the
# 4096-token Qwen3.5-4B session.
TOP_K=6
CHUNK_TOP_K=3
# Retrieve a wider vector/BM25 pool, fuse with weighted RRF, then let the
# existing reranker keep CHUNK_TOP_K evidence chunks.
RK_LEXICAL_RETRIEVAL=true
RK_RETRIEVAL_CANDIDATE_K=6
RK_RRF_VECTOR_WEIGHT=1.0
RK_RRF_LEXICAL_WEIGHT=1.5
RK_LEXICAL_EXACT_BOOST=2.0
RK_LEXICAL_PASSAGE_CHARS=1200
RK_LEXICAL_QUERY_EXPANSIONS='{"usb":["USB_TEST","CherryUSB ADB","product","speed=5000","timestamps:"],"产品号":["PN","SET_PN","PN_GET","BURN_CHECK_PN"],"sn":["SN_MATCH_SOC","SN_MATCH_FAN_DET"],"ready":["curl","--unix-socket","/tmp/rkrag_cli.sock","http://localhost/status"],"复现":["device.inf","rkauth_tool_bin","key.lic","deploy_rkrag.sh","run.sh","run_server.sh","/userdata/rkrag_cli/rag_model/"]}'
RK_DERIVED_SOURCE_PATTERNS=技术方案
RK_DERIVED_SOURCE_PENALTY=0.2
RK_THIN_EVIDENCE_PENALTY=0.25
RK_EXACT_EVIDENCE_BOOST_PER_TERM=0.4
RK_ANSWER_CACHE_VERSION=query-answer-cache-rk-reproduction-anchors-v33
MAX_ENTITY_TOKENS=500
MAX_RELATION_TOKENS=300
MAX_TOTAL_TOKENS=3000
# Enforced server-side for mix queries, including browsers with stale UI state.
RK_MIX_MAX_TOTAL_TOKENS=3000
SUMMARY_CONTEXT_SIZE=2800
# Paragraph-semantic chunks feed the entity-extraction prompt twice (initial
# extraction plus gleaning). Keep them at 1000 for the 4096-token 4B window.
CHUNK_P_SIZE=1000
EXTRACT_LLM_MODEL=qwen3.5-4b
EXTRACT_MAX_ASYNC_LLM=1
KEYWORD_LLM_MODEL=qwen3.5-4b
KEYWORD_MAX_ASYNC_LLM=1
QUERY_LLM_MODEL=qwen3.5-4b-query
QUERY_MAX_ASYNC_LLM=1

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://127.0.0.1:8100/v1
EMBEDDING_BINDING_API_KEY=local-no-key
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=2048
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_BATCH_NUM=1
EMBEDDING_DOCUMENT_PREFIX=NO_PREFIX
EMBEDDING_QUERY_PREFIX='Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: '

RERANK_BINDING=cohere
RERANK_BINDING_HOST=http://127.0.0.1:8100/v1/rerank
RERANK_BINDING_API_KEY=local-no-key
RERANK_MODEL=qwen3-reranker-0.6b
RERANK_BY_DEFAULT=true
MAX_ASYNC_RERANK=1
RERANK_TIMEOUT=60
MIN_RERANK_SCORE=0.0

LIGHTRAG_PARSER='pdf:rkvision-P,*:legacy-R'
MAX_PARALLEL_PARSE_RKVISION=1
VLM_PROCESS_ENABLE=false
RK_VISION_DAEMON=/userdata/document-vision-service/bin/document_vision_daemon
RK_VISION_LAYOUT_MODEL=/userdata/doclayout-yolo-rknn-service/models/doclayout_yolo_640_logits_i8.rknn
RK_VISION_OCR_MODELS=/userdata/ppocrv6-rknn-service/models
RK_VISION_OCR_DICT=/userdata/ppocrv6-rknn-service/models/ppocrv6_dict.txt
LD_LIBRARY_PATH=/userdata/document-vision-service/lib:/userdata/doclayout-yolo-rknn-service/lib:/userdata/ppocrv6-rknn-service/lib
