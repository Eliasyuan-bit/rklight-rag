# Copy into deploy/lightrag.env. Paths below match board.env.example defaults.
HOST=0.0.0.0
PORT=9621
WORKING_DIR=/userdata/lightrag-data
INPUT_DIR=/userdata/lightrag-data/inputs
LOG_DIR=/userdata/lightrag-data/logs
TIKTOKEN_CACHE_DIR=/userdata/lightrag-data/tiktoken_cache
WORKERS=1
LOG_LEVEL=INFO
RK_INGEST_MODEL_MODE_ENABLED=1
RK_MODEL_GATEWAY_ADMIN_URL=http://127.0.0.1:8100

LLM_BINDING=openai
LLM_BINDING_HOST=http://127.0.0.1:8100/v1
LLM_BINDING_API_KEY=local-no-key
LLM_MODEL=qwen3.5-2b
LLM_TIMEOUT=240
OPENAI_LLM_MAX_COMPLETION_TOKENS=512
MAX_ASYNC_LLM=1
# Stateless extraction pages replace LightRAG's history-replaying gleaning.
MAX_GLEANING=0
MAX_EXTRACTION_RECORDS=4
MAX_EXTRACTION_ENTITIES=3
MAX_EXTRACTION_PAGES=6
# Sentence-aligned extraction-only windows; stored chunks/citations stay intact.
EXTRACTION_PAGE_CHARS=180
OPENAI_LLM_EXTRA_BODY='{"enable_thinking":false}'
EXTRACT_LLM_MODEL=qwen3.5-4b
EXTRACT_MAX_ASYNC_LLM=1
KEYWORD_LLM_MODEL=qwen3.5-2b
KEYWORD_MAX_ASYNC_LLM=1
QUERY_LLM_MODEL=qwen3.5-2b-query
QUERY_MAX_ASYNC_LLM=1

# Both deployed LLM roles use a 4096-token context window. Keep retrieved
# context below 3000 tokens so mix mode can retain source chunks. Query answers
# are capped at 256 tokens by the gateway.
TOP_K=6
CHUNK_TOP_K=3
# Retrieve a wider vector/BM25 pool, fuse with weighted RRF, then let the
# existing reranker keep CHUNK_TOP_K evidence chunks.
RK_LEXICAL_RETRIEVAL=true
RK_RETRIEVAL_CANDIDATE_K=6
RK_RRF_VECTOR_WEIGHT=1.0
RK_RRF_LEXICAL_WEIGHT=1.5
RK_LEXICAL_EXACT_BOOST=2.0
RK_LEXICAL_PASSAGE_CHARS=2400
RK_ANSWER_CACHE_VERSION=query-answer-cache-rk-lexical-v2
MAX_ENTITY_TOKENS=500
MAX_RELATION_TOKENS=300
MAX_TOTAL_TOKENS=3000
# Enforced server-side for mix queries, including browsers with stale UI state.
RK_MIX_MAX_TOTAL_TOKENS=3000
SUMMARY_CONTEXT_SIZE=2800
# Paragraph-semantic chunks use bounded, stateless extraction pages.
CHUNK_P_SIZE=1000
# Dense recursive chunks stay at 500 so every page fits the 4096-token session.
CHUNK_R_SIZE=500
CHUNK_R_OVERLAP_SIZE=100

EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://127.0.0.1:8100/v1
EMBEDDING_BINDING_API_KEY=local-no-key
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=2048
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_BATCH_NUM=1
EMBEDDING_DOCUMENT_PREFIX=NO_PREFIX
EMBEDDING_QUERY_PREFIX='Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: '

RERANK_BINDING=cohere
RERANK_BINDING_HOST=http://127.0.0.1:8100/v1/rerank
RERANK_BINDING_API_KEY=local-no-key
RERANK_MODEL=qwen3-reranker-0.6b
RERANK_BY_DEFAULT=true
MAX_ASYNC_RERANK=1
RERANK_TIMEOUT=60
MIN_RERANK_SCORE=0.0

# The selected parser profile is sourced after this file at startup. Cloud mode
# needs MINERU_API_TOKEN=<your_api_key>. RKVision mode uses the paths below.
RK_VISION_DAEMON=/userdata/rklight-rag/document-vision/bin/document_vision_daemon
RK_VISION_LAYOUT_MODEL=/userdata/doclayout-yolo-rknn-service/models/doclayout_yolo_640_logits_i8.rknn
RK_VISION_OCR_MODELS=/userdata/ppocrv6-rknn-service/models
RK_VISION_OCR_DICT=/userdata/ppocrv6-rknn-service/models/ppocrv6_dict.txt
RK_VISION_TABLEFORMER_PDF=/userdata/tableformer_cpu/run_pdf.sh
LD_LIBRARY_PATH=/userdata/rklight-rag/document-vision/lib:/userdata/doclayout-yolo-rknn-service/lib:/userdata/ppocrv6-rknn-service/lib
