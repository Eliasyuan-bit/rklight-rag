# ADB target.  Replace with the actual board serial or host:port.
export ADB_SERIAL=192.168.1.100:5555

# Board deployment roots.  No project-specific host name is required.
export BOARD_APP_ROOT=/userdata/rklight-rag
export BOARD_DATA_ROOT=/userdata/lightrag-data
export LIGHTRAG_PORT=9621
export MODEL_GATEWAY_PORT=8100
# cloud: official MinerU API; rkvision: local PDFium + Layout + PPOCR.
export PDF_PARSER_MODE=cloud

# Existing board-side native model services and model assets.
export LLM_SERVICE_ROOT=/userdata/rk1828-rag-model-service
export VECTOR_SERVICE_ROOT=/userdata/RK1828-qwen3-embedding-reranker-service
export PPOCR_SERVICE_ROOT=/userdata/ppocrv6-rknn-service
export LAYOUT_SERVICE_ROOT=/userdata/doclayout-yolo-rknn-service
