# Local RK3588 PDF parser registered as a LightRAG third-party parser plugin.
# Current adapter persists reading-order text; use R until it emits the full
# LightRAG sidecar format required by paragraph-semantic P chunking.
LIGHTRAG_PARSER='pdf:rkvision-R,*:legacy-R'
MAX_PARALLEL_PARSE_RKVISION=1
VLM_PROCESS_ENABLE=false
