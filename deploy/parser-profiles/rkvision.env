# Local RK3588 PDF parser registered as a LightRAG third-party parser plugin.
# RKVision emits page/layout provenance for PDFs. LightRAG's native Markdown
# parser preserves ATX headings, tables and code blocks. Both therefore use
# paragraph-semantic chunking instead of flattening to recursive text.
LIGHTRAG_PARSER='pdf:rkvision-P,md:native-P,*:legacy-R'
MAX_PARALLEL_PARSE_RKVISION=1
VLM_PROCESS_ENABLE=false
